# ── Database (Supabase) ──────────────────────────────────────────────
# Supabase dashboard → Project Settings → Database → Connection string → URI
# Use the Transaction pooler string (port 6543) for serverless hosting.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# ── Dodo Payments ────────────────────────────────────────────────────
# Dashboard → Developer → API keys
DODO_API_KEY=""
# A product with "pay what you want" enabled. Every bid charges into this product.
DODO_PRODUCT_ID=""
# Dashboard → Developer → Webhooks → your endpoint → signing key
DODO_WEBHOOK_KEY=""
# "test" while you are testing, anything else uses live mode
DODO_ENV="live"

# ── Site ─────────────────────────────────────────────────────────────
# Public origin, used for the checkout return url. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Local development only: lets bids skip payment. Never set this in production.
# ALLOW_UNPAID_BIDS="true"
